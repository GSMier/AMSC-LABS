{
  "name": "AMSC Development Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--platform=linux/amd64",
    "--name=amsc"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/home/ubuntu/${localWorkspaceFolderBasename}",
  "remoteUser": "ubuntu",
  "postCreateCommand": "grep -qxF 'source /u/sw/etc/bash.bashrc' ~/.bashrc || printf '%s\\n' 'source /u/sw/etc/bash.bashrc' >> ~/.bashrc; .devcontainer/configure-clangd.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "matepek.vscode-catch2-test-adapter",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "cschlosser.doxdocgen",
        "danielpinto8zz6.c-cpp-compile-run"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "clangd.arguments": [
          "--query-driver=/usr/bin/g++,/usr/bin/gcc,/u/sw/toolchains/gcc-glibc/11.2.0/prefix/bin/g++,/u/sw/toolchains/gcc-glibc/11.2.0/prefix/bin/gcc"
        ]
      }
    }
  }
}